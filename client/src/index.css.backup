@import "tailwindcss";

@custom-variant dark (&:where(.dark, .dark *));

/* =========================================================
   YIZ-AMS GLOBAL THEME
   Inspired by the Water Sales Manager visual system
========================================================= */

:root {
  color-scheme: light;

  /* App surfaces */
  --app-bg: #f0f9ff;
  --surface: #ffffff;
  --surface-secondary: #f8fcff;
  --surface-hover: #eef8ff;

  /* Text */
  --text-primary: #03045e;
  --text-secondary: #4a6fa5;
  --text-muted: #64748b;
  --text-inverse: #ffffff;

  /* YIZ-AMS Blue Palette */
  --accent: #0077b6;
  --accent-dark: #023e8a;
  --accent-light: #90e0ef;
  --accent-bright: #00b4d8;

  --accent-bg: #eaf8ff;
  --accent-border: #90e0ef;

  /* Status Colors */
  --success: #06d6a0;
  --success-bg: #ecfdf5;
  --success-border: #6ee7b7;

  --warning: #ffb703;
  --warning-bg: #fffbeb;
  --warning-border: #fcd34d;

  --danger: #ef476f;
  --danger-bg: #fff1f2;
  --danger-border: #fda4af;

  --info: #00b4d8;
  --info-bg: #ecfeff;
  --info-border: #67e8f9;

  /* Borders */
  --border: #caf0f8;
  --border-light: #e2f3f8;

  /* Shadows */
  --shadow-sm: 0 2px 8px rgba(3, 62, 100, 0.06);
  --shadow: 0 10px 30px rgba(3, 62, 100, 0.08);
  --shadow-lg: 0 18px 45px rgba(3, 62, 100, 0.12);

  /* Compatibility with existing YIZ-AMS styles */
  --social-bg: #f8fcff;
  --text-h: #03045e;

  /* Radius */
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 20px;
  --radius-2xl: 24px;
}

/* =========================================================
   DARK MODE
========================================================= */

.dark {
  color-scheme: dark;

  /* App surfaces */
  --app-bg: #03045e;
  --surface: #0a1628;
  --surface-secondary: #0d1b2e;
  --surface-hover: #10243b;

  /* Text */
  --text-primary: #caf0f8;
  --text-secondary: #90e0ef;
  --text-muted: #94a3b8;
  --text-inverse: #ffffff;

  /* Blue Palette */
  --accent: #00b4d8;
  --accent-dark: #0077b6;
  --accent-light: #023e8a;
  --accent-bright: #90e0ef;

  --accent-bg: #062f49;
  --accent-border: #0077b6;

  /* Status Colors */
  --success: #06d6a0;
  --success-bg: #063c32;
  --success-border: #087f68;

  --warning: #ffb703;
  --warning-bg: #3d3006;
  --warning-border: #a77b00;

  --danger: #ef476f;
  --danger-bg: #3d1220;
  --danger-border: #a52f4d;

  --info: #00b4d8;
  --info-bg: #063747;
  --info-border: #087f99;

  /* Borders */
  --border: #0077b6;
  --border-light: #12314a;

  /* Shadows */
  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.25);
  --shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  --shadow-lg: 0 18px 45px rgba(0, 0, 0, 0.45);

  /* Compatibility */
  --social-bg: #0a1628;
  --text-h: #caf0f8;
}

/* =========================================================
   GLOBAL DOCUMENT
========================================================= */

html,
body,
#root {
  min-height: 100%;
}

html {
  background: var(--app-bg);
  transition:
    background-color 0.25s ease,
    color 0.25s ease;
}

body {
  margin: 0;
  background: var(--app-bg);
  color: var(--text-primary);

  font-family:
    Inter,
    "Segoe UI",
    Roboto,
    Helvetica,
    Arial,
    sans-serif;

  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;

  transition:
    background-color 0.25s ease,
    color 0.25s ease;
}

/* =========================================================
   UNIVERSAL BOX SIZING
========================================================= */

*,
*::before,
*::after {
  box-sizing: border-box;
}

/* =========================================================
   SMOOTH THEME TRANSITIONS
========================================================= */

body,
button,
input,
textarea,
select,
section,
header,
aside,
main,
nav,
article,
div {
  transition:
    background-color 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease;
}

/* =========================================================
   LINKS
========================================================= */

a {
  color: var(--accent);
  transition:
    color 0.2s ease,
    opacity 0.2s ease;
}

a:hover {
  color: var(--accent-dark);
}

.dark a:hover {
  color: var(--accent-bright);
}

/* =========================================================
   BUTTONS
========================================================= */

button {
  font-family: inherit;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

/* =========================================================
   FORM CONTROLS
========================================================= */

input,
textarea,
select {
  font-family: inherit;
}

input::placeholder,
textarea::placeholder {
  color: var(--text-muted);
  opacity: 0.75;
}

input:focus,
textarea:focus,
select:focus {
  outline: none;
}

.dark input,
.dark textarea,
.dark select {
  color-scheme: dark;
}

/* =========================================================
   FOCUS ACCESSIBILITY
========================================================= */

button:focus-visible,
a:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
  outline: 2px solid var(--accent-bright);
  outline-offset: 2px;
}

/* =========================================================
   SCROLLBAR
========================================================= */

html {
  scrollbar-width: thin;
  scrollbar-color: #90e0ef transparent;
}

::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: #90e0ef;
  border-radius: 999px;
}

::-webkit-scrollbar-thumb:hover {
  background: #00b4d8;
}

.dark {
  scrollbar-color: #0077b6 #03045e;
}

.dark ::-webkit-scrollbar-track {
  background: #03045e;
}

.dark ::-webkit-scrollbar-thumb {
  background: #0077b6;
}

.dark ::-webkit-scrollbar-thumb:hover {
  background: #00b4d8;
}

/* =========================================================
   YIZ-AMS CARD HELPERS
========================================================= */

.yiz-card {
  background: var(--surface);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.yiz-card:hover {
  box-shadow: var(--shadow);
}

/* =========================================================
   YIZ-AMS STAT CARD
========================================================= */

.yiz-stat-card {
  background: var(--surface);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-lg);
  padding: 1.25rem;
  box-shadow: var(--shadow-sm);
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    border-color 0.2s ease;
}

.yiz-stat-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow);
  border-color: var(--accent-border);
}

/* =========================================================
   YIZ-AMS PRIMARY BUTTON
========================================================= */

.yiz-primary-btn {
  background: var(--accent);
  color: #ffffff;
  border: none;
  border-radius: var(--radius-md);
  padding: 0.65rem 1rem;
  font-weight: 600;
  cursor: pointer;
  box-shadow: var(--shadow-sm);

  transition:
    background-color 0.2s ease,
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.yiz-primary-btn:hover {
  background: var(--accent-dark);
  transform: translateY(-1px);
  box-shadow: var(--shadow);
}

.yiz-primary-btn:active {
  transform: translateY(0);
}

/* =========================================================
   YIZ-AMS SECONDARY BUTTON
========================================================= */

.yiz-secondary-btn {
  background: var(--accent-bg);
  color: var(--accent);
  border: 1px solid var(--accent-border);
  border-radius: var(--radius-md);
  padding: 0.65rem 1rem;
  font-weight: 600;
  cursor: pointer;

  transition:
    background-color 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease;
}

.yiz-secondary-btn:hover {
  background: var(--accent-light);
  border-color: var(--accent);
  transform: translateY(-1px);
}

/* =========================================================
   YIZ-AMS INPUT
========================================================= */

.yiz-input {
  width: 100%;
  background: var(--surface);
  color: var(--text-primary);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 0.7rem 0.85rem;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background-color 0.2s ease;
}

.yiz-input:hover {
  border-color: var(--accent-border);
}

.yiz-input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-bg);
}

/* =========================================================
   STATUS BADGES
========================================================= */

.yiz-status-success {
  background: var(--success-bg);
  color: var(--success);
  border: 1px solid var(--success-border);
}

.yiz-status-warning {
  background: var(--warning-bg);
  color: var(--warning);
  border: 1px solid var(--warning-border);
}

.yiz-status-danger {
  background: var(--danger-bg);
  color: var(--danger);
  border: 1px solid var(--danger-border);
}

.yiz-status-info {
  background: var(--info-bg);
  color: var(--info);
  border: 1px solid var(--info-border);
}

/* =========================================================
   GRADIENT HEADER
========================================================= */

.yiz-gradient-header {
  background:
    linear-gradient(
      135deg,
      var(--accent-dark) 0%,
      var(--accent) 100%
    );
  color: #ffffff;
}

/* =========================================================
   TABLES
========================================================= */

table {
  border-collapse: collapse;
}

thead {
  background: var(--surface-secondary);
}

th {
  color: var(--text-secondary);
  font-weight: 600;
}

td {
  color: var(--text-primary);
}

tbody tr {
  border-bottom: 1px solid var(--border-light);
}

tbody tr:hover {
  background: var(--surface-hover);
}

/* =========================================================
   SELECTION
========================================================= */

::selection {
  background: var(--accent-light);
  color: var(--accent-dark);
}

.dark ::selection {
  background: var(--accent-dark);
  color: #ffffff;
}

/* =========================================================
   MOBILE RESPONSIVENESS
========================================================= */

@media (max-width: 640px) {
  body {
    font-size: 14px;
  }

  .yiz-stat-card {
    padding: 1rem;
    border-radius: var(--radius-md);
  }
}

/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}