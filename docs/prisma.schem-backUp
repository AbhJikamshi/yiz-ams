generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @default(ADMIN)

  announcements Announcement[]
  notifications Notification[]
}

model Member {
  id            Int            @id @default(autoincrement())
  fullName      String
  phone         String?
  email         String?        @unique
  createdAt     DateTime       @default(now())
  address       String?
  status        String         @default("ACTIVE")
  updatedAt     DateTime       @updatedAt

  contributions Contribution[]
  notifications Notification[]
}

model Contribution {
  id          Int                @id @default(autoincrement())
  year        Int
  amount      Float
  memberId    Int
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  monthNumber Int
  paymentDate DateTime           @default(now())
  status      ContributionStatus @default(PAID)

  member Member @relation(
    fields: [memberId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([memberId, monthNumber, year])
  @@index([memberId])
  @@index([year, monthNumber])
}

model Expense {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  category    String
  amount      Float
  expenseDate DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expenseDate])
}

model Setting {
  id                        Int      @id @default(autoincrement())
  associationName           String
  associationLogo           String?
  monthlyContributionAmount Float
  currency                  String   @default("NGN")

  financialYearStart Int
  financialYearEnd   Int

  meetingDay   String?
  meetingTime  String?
  meetingVenue String?

  chairmanName  String?
  secretaryName String?
  treasurerName String?

  phone   String?
  email   String?
  website String?
  address String?

  receiptPrefix      String @default("RC")
  contributionPrefix String @default("CON")
  expensePrefix      String @default("EXP")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id      Int    @id @default(autoincrement())
  title   String
  message String

  createdById Int
  createdBy   Admin @relation(
    fields: [createdById],
    references: [id]
  )

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
}

model Notification {
  id      Int    @id @default(autoincrement())
  title   String
  message String

  type NotificationType @default(GENERAL)

  memberId Int?
  member Member? @relation(
    fields: [memberId],
    references: [id],
    onDelete: Cascade
  )

  createdById Int
  createdBy Admin @relation(
    fields: [createdById],
    references: [id]
  )

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([memberId])
  @@index([createdById])
}

enum Role {
  ADMIN
  MEMBER
}

enum ContributionStatus {
  PAID
  PENDING
  PARTIAL
  WAIVED
}

enum NotificationType {
  GENERAL
  MEETING
  PAYMENT
  REMINDER
}